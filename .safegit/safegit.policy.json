{
  "allowed_repo_roots": [],
  "approvals": {
    "max_uses": 1,
    "require_interactive": true,
    "store": "",
    "ttl_seconds": 900
  },
  "audit": {
    "enabled": true,
    "include_command": false,
    "path": "",
    "retention_days": 30
  },
  "ci_paths": [
    ".github/workflows/**",
    ".github/actions/**",
    ".gitlab-ci.yml",
    "Jenkinsfile",
    ".circleci/**"
  ],
  "commit_preflight": {
    "block_conflict_markers": true,
    "block_denied_paths": true,
    "enabled": true,
    "generated_paths": [],
    "max_added_lines": 900,
    "max_deleted_lines": 900,
    "max_file_bytes": 5242880,
    "max_files": 40,
    "warn_generated_paths": true
  },
  "enforcement": "binding",
  "guard_opaque_tools": false,
  "interactive": true,
  "profile": "default",
  "protect_default_branch_commits": false,
  "protected_branches": [
    "main",
    "master",
    "trunk",
    "develop",
    "release/*",
    "release-*"
  ],
  "protected_paths": [
    ".git",
    ".git/**",
    ".safegit",
    ".safegit/**",
    "safegit.policy.json",
    "**/safegit.policy.json",
    "opencode.json",
    "opencode.jsonc",
    ".opencode/**",
    ".claude/settings.json",
    ".claude/settings.local.json",
    ".claude/hooks/**",
    "**/.gitconfig",
    "**/.config/git/config",
    "**/.npmrc"
  ],
  "rules": {
    "fs.ci_write": "REQUIRE_OWNER",
    "fs.other_write": "ALLOW",
    "fs.protected_write": "DENY",
    "fs.repo_escape_write": "ALLOW",
    "fs.secret_write": "DENY",
    "git.add.all": "ALLOW",
    "git.branch.delete.force": "REQUIRE_OWNER",
    "git.branch.delete.safe": "ALLOW",
    "git.branch.rename": "ALLOW",
    "git.checkout.discard": "DENY",
    "git.checkout.switch": "ALLOW",
    "git.clean.force": "DENY",
    "git.commit.amend": "REQUIRE_OWNER",
    "git.commit.plain": "ALLOW",
    "git.config.inline_override": "REQUIRE_OWNER",
    "git.config.write": "REQUIRE_OWNER",
    "git.history.expire": "DENY",
    "git.history.filter": "DENY",
    "git.hook.bypass": "DENY",
    "git.merge": "ALLOW",
    "git.non_destructive": "ALLOW",
    "git.other": "UNKNOWN",
    "git.push.broad": "REQUIRE_OWNER",
    "git.push.delete_branch": "REQUIRE_OWNER",
    "git.push.force": "DENY",
    "git.push.force_with_lease": "REQUIRE_OWNER",
    "git.push.plain": "ALLOW",
    "git.rebase": "REQUIRE_OWNER",
    "git.rebase.continue": "ALLOW",
    "git.ref.write": "REQUIRE_OWNER",
    "git.remote.change": "REQUIRE_OWNER",
    "git.repo.override": "REQUIRE_OWNER",
    "git.reset.hard": "DENY",
    "git.reset.keep": "DENY",
    "git.restore.worktree": "DENY",
    "git.rm.tracked": "REQUIRE_OWNER",
    "git.stash.destroy": "DENY",
    "git.submodule.change": "REQUIRE_OWNER",
    "git.tag.delete": "REQUIRE_OWNER",
    "git.worktree.prune": "ALLOW",
    "git.worktree.remove": "REQUIRE_OWNER"
  },
  "schema": "safegit.policy/1",
  "secret_paths": [
    "**/.env",
    "**/.env.*",
    "**/*.pem",
    "**/*.key",
    "**/credentials",
    "**/credentials.*",
    "**/*_secret",
    "**/*_secret.*",
    "**/.aws/**",
    "**/.ssh/**",
    "**/id_rsa*",
    "**/.netrc",
    "**/.bashrc",
    "**/.zshrc",
    "**/.profile",
    "**/.bash_profile",
    "**/.config/powershell/**",
    "**/.local/share/powershell/**"
  ],
  "unknown_git_operations": "REQUIRE_OWNER"
}
